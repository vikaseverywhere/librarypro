rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function belongsToLibrary(libraryId) {
      return isSignedIn()
        && exists(userDoc(request.auth.uid))
        && (
          get(userDoc(request.auth.uid)).data.libraryId == libraryId
          || (
            get(userDoc(request.auth.uid)).data.libraryIds != null
            && get(userDoc(request.auth.uid)).data.libraryIds.hasAny([libraryId])
          )
        );
    }
    
    // Users collection - each user document
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    
    // Libraries collection with subcollections
    match /libraries/{libraryId} {
      // Owner can always read/write their own libraries via `ownerUid`,
      // and also via membership (libraryIds/libraryId) for extra safety.
      allow read: if belongsToLibrary(libraryId)
        || (resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if belongsToLibrary(libraryId)
        || (resource.data.ownerUid == request.auth.uid);
      
      // Students subcollection
      match /students/{studentId} {
        allow read: if belongsToLibrary(libraryId);
        allow create: if belongsToLibrary(libraryId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.seatNumber is number
          && request.resource.data.seatNumber > 0;
        allow update: if belongsToLibrary(libraryId)
          && (!('seatNumber' in request.resource.data)
              || (request.resource.data.seatNumber is number
                  && request.resource.data.seatNumber > 0));
        allow delete: if belongsToLibrary(libraryId);
      }
      
      // Fees subcollection
      match /fees/{feeId} {
        allow read: if belongsToLibrary(libraryId);
        allow create: if belongsToLibrary(libraryId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status in ['pending', 'overdue']
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() > 0;
        allow update: if belongsToLibrary(libraryId)
          && (!('amount' in request.resource.data)
              || (request.resource.data.amount is number
                  && request.resource.data.amount > 0))
          && (!('status' in request.resource.data)
              || request.resource.data.status in ['pending', 'paid', 'overdue', 'waived']);
        allow delete: if belongsToLibrary(libraryId);
      }
      
      // Plans subcollection
      match /plans/{planId} {
        allow read, write: if belongsToLibrary(libraryId);
      }
      
      // Transactions subcollection — append-only ledger (no update or delete)
      match /transactions/{transactionId} {
        allow read: if belongsToLibrary(libraryId);
        allow create: if belongsToLibrary(libraryId);
      }
      
      // Invoices storage (future subcollection)
      match /invoices/{invoiceId} {
        allow read: if belongsToLibrary(libraryId);
        allow write: if false; // Only Cloud Functions can write
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
